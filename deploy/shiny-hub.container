# The landing page listing the apps. See shiny-met.container for why the IP is
# fixed and why RunInit=yes is here.

[Unit]
Description=Hub landing page
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=hub
Image=localhost/shiny-hub:latest
Network=shiny.network
IP=172.30.17.11
RunInit=yes

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target default.target
